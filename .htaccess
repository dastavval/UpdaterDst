# Dastavval PHP/cPanel Host Configuration
# ============================================================
# نقطه ورود هوشمند پلتفرم دست اول برای هاست‌های اشتراکی

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. API Route Redirect to PHP Handler
    RewriteRule ^api/index\.php$ php/api.php [L,QSA]
    RewriteRule ^api/(.*)$ php/api.php?action=$1 [L,QSA]

    # 2. Existing File or Directory Pass
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Native PHP Fallback (Proxy Logic)
    RewriteRule ^ index.php [L]
</IfModule>

# Caching for assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
